<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Account Bar & Menu Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151515"
        android:padding="8dp">
        <TextView
            android:id="@+id/tvAccountInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Acc: #0/0 | Tap DATA"
            android:textColor="#FFCC00"
            android:textSize="12sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnDataMenu"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⚙️ DATA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Status Bar -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#222"
        android:padding="6dp"
        android:text="Status: Ready"
        android:textColor="#00FF66"
        android:textSize="12sp" />

    <!-- Web View Frame -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- The 4 Instant Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="4"
        android:background="#000">
        <Button
            android:id="@+id/btnStep1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1.LOGIN"
            android:textSize="10sp" />
        <Button
            android:id="@+id/btnStep2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2.MAHARA"
            android:textSize="10sp" />
        <Button
            android:id="@+id/btnStep3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3.BET"
            android:textSize="10sp" />
        <Button
            android:id="@+id/btnStep4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4.NEXT"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>